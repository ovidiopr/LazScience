<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <PathDelim Value="\"/>
    <Name Value="LazScience"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Ovidio Y. Peña Rodríguez"/>
    <CompilerOptions>
      <Version Value="11"/>
      <PathDelim Value="\"/>
      <SearchPaths>
        <UnitOutputDirectory Value="lib\$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="LazScience is a package of Lazarus/Free Pascal (LCL) components for building scientific and engineering-instrument applications"/>
    <License Value="This package is released under the GNU Lesser General Public License v2.1 or later (LGPL-2.1-or-later).

You are free to use, study, modify, and redistribute it under the terms of the LGPL. If you distribute a modified version of this package or any of its components, you must do so under the same license.

See [https://www.gnu.org/licenses/lgpl-2.1.html](https://www.gnu.org/licenses/lgpl-2.1.html) for the full license text."/>
    <Version Major="1"/>
    <Files>
      <Item>
        <Filename Value="usciedit.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciEdit"/>
      </Item>
      <Item>
        <Filename Value="uscipid.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciPID"/>
      </Item>
      <Item>
        <Filename Value="uscireader.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciReader"/>
      </Item>
      <Item>
        <Filename Value="uscireaderdlg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciReaderDlg"/>
      </Item>
      <Item>
        <Filename Value="uscithermocouple.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciThermoCouple"/>
      </Item>
      <Item>
        <Filename Value="uscidm3.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciDM3"/>
      </Item>
      <Item>
        <Filename Value="uscidm3connector.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciDM3Connector"/>
      </Item>
      <Item>
        <Filename Value="usciperiodictable.pas"/>
        <UnitName Value="uSciPeriodicTable"/>
      </Item>
      <Item>
        <Filename Value="usciperiodictabledlg.pas"/>
        <UnitName Value="uSciPeriodicTableDlg"/>
      </Item>
      <Item>
        <Filename Value="usciperiodictablereg.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciPeriodicTableReg"/>
      </Item>
      <Item>
        <Filename Value="uscirestorer.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="uSciRestorer"/>
      </Item>
    </Files>
    <RequiredPkgs>
      <Item>
        <PackageName Value="LazControls"/>
      </Item>
      <Item>
        <PackageName Value="LCLBase"/>
      </Item>
      <Item>
        <PackageName Value="FCL"/>
      </Item>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
      <UseFileFilters Value="True"/>
    </PublishOptions>
  </Package>
</CONFIG>
