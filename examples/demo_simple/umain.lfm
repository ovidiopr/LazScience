object Form1: TForm1
  Left = 400
  Height = 450
  Top = 200
  Width = 480
  Caption = 'Simple TSciEdit Demo'
  ClientHeight = 450
  ClientWidth = 480
  Position = poScreenCenter
  LCLVersion = '4.6.0.0'
  OnCreate = FormCreate
  object GroupBox1: TGroupBox
    Left = 10
    Height = 150
    Top = 10
    Width = 460
    Caption = ' Input  Controls '
    ClientHeight = 130
    ClientWidth = 456
    TabOrder = 0
    object SciEdit1: TSciEdit
      Left = 8
      Height = 23
      Top = 16
      Width = 180
      TrackBar = TrackBar1
      TrackBarFactor = 2
      TrackBarSettleDelay = 300
      OnValueChanged = SciEdit1ValueChanged
      OnParseError = SciEdit1ParseError
      ParentShowHint = False
      ShowHint = True
      TabOrder = 0
    end
    object TrackBar1: TTrackBar
      Left = 8
      Height = 30
      Top = 56
      Width = 432
      Max = 100
      Min = -100
      Position = 0
      ShowSelRange = False
      TickStyle = tsNone
      TabOrder = 3
    end
    object ComboBoxFamily: TComboBox
      Left = 200
      Height = 23
      Top = 16
      Width = 139
      ItemHeight = 15
      ItemIndex = 0
      Items.Strings = (
        'ufAny'
        'ufNone'
        'ufLength'
        'ufMass'
        'ufTime'
        'ufVoltage'
        'ufCurrent'
        'ufResistance'
        'ufFrequency'
        'ufPressure'
        'ufTemperature'
        'ufForce'
        'ufEnergy'
        'ufPower'
        'ufVolume'
        'ufVelocity'
        'ufDensity'
        'ufVolumetricFlow'
        'ufMassFlow'
        'ufGasThroughput'
        'ufAcceleration'
        'ufArea'
        'ufCharge'
        'ufCapacitance'
        'ufInductance'
        'ufMagneticFlux'
        'ufMagneticField'
        'ufWavenumber'
      )
      Style = csDropDownList
      TabOrder = 1
      Text = 'ufAny'
      OnChange = ComboBoxFamilyChange
    end
    object BtnReformat: TButton
      Left = 344
      Height = 25
      Top = 12
      Width = 96
      Caption = 'Reformat'
      TabOrder = 2
      OnClick = BtnReformatClick
    end
  end
  object GroupBox2: TGroupBox
    Left = 10
    Height = 112
    Top = 170
    Width = 460
    Caption = ' Detailed Parsing Results '
    ClientHeight = 92
    ClientWidth = 456
    TabOrder = 1
    object LblValue: TLabel
      Left = 16
      Height = 15
      Top = 8
      Width = 69
      Caption = 'Parsed Value:'
    end
    object LblUnit: TLabel
      Left = 16
      Height = 15
      Top = 32
      Width = 75
      Caption = 'Detected Unit:'
    end
    object LblPrefix: TLabel
      Left = 232
      Height = 15
      Top = 32
      Width = 82
      Caption = 'Detected Prefix:'
    end
    object LblCanonical: TLabel
      Left = 16
      Height = 15
      Top = 64
      Width = 125
      Caption = 'Canonical (Base) Value:'
      Font.Style = [fsBold]
      ParentFont = False
    end
    object LblFamily: TLabel
      Left = 232
      Height = 15
      Top = 8
      Width = 88
      Caption = 'Detected Family:'
    end
  end
  object GroupBox3: TGroupBox
    Left = 10
    Height = 144
    Top = 290
    Width = 460
    Caption = ' Event Log '
    ClientHeight = 124
    ClientWidth = 456
    TabOrder = 2
    object MemoLog: TMemo
      Left = 8
      Height = 108
      Top = 8
      Width = 440
      ReadOnly = True
      ScrollBars = ssAutoVertical
      TabOrder = 0
    end
  end
end
